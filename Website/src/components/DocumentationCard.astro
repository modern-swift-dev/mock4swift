---
interface Props {
  title: string;
  description: string;
  href: string;
  label?: string;
}

const { title, description, href, label = "Read the guide" } = Astro.props;
---

<article class="card flex h-full flex-col">
  <h3 class="text-xl font-bold">{title}</h3>
  <p class="mt-3 flex-1 leading-7 text-muted">{description}</p>
  <a class="mt-6 font-semibold text-indigo-700" href={href}>{label}<span aria-hidden="true"> →</span></a>
</article>
