---
import type { Release } from "../lib/release";

interface Props { release: Release; }
const { release } = Astro.props;
const date = new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" }).format(release.publishedAt);
---

<article class="card gradient-panel relative overflow-hidden">
  <div class="absolute -top-12 -right-12 size-36 rounded-full bg-violet-300/30 blur-2xl" aria-hidden="true"></div>
  <p class="eyebrow">Latest release</p>
  <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="text-3xl font-bold tracking-tight">{release.version}</h2>
      <p class="mt-2 text-muted">Published {date}</p>
    </div>
    <a class="button-secondary" href={release.notesURL}>Release notes</a>
  </div>
  <div class="mt-6 rounded-xl border border-indigo-100 bg-white/80 px-4 py-3 font-mono text-sm text-indigo-950">
    <span class="text-muted">Package version</span> {release.installationVersion}
  </div>
</article>
