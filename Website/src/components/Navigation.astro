---
import { sitePath } from "../lib/paths";

const currentPath = Astro.url.pathname;
const links = [
  { href: sitePath("/documentation/"), label: "Documentation" },
  { href: sitePath("/examples/"), label: "Examples" },
  { href: "https://github.com/modern-swift-dev/mocksmith-swift", label: "GitHub" },
];
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-white/95 backdrop-blur">
  <nav class="page-shell flex min-h-18 items-center justify-between gap-6" aria-label="Main navigation">
    <a class="flex items-center gap-3 font-bold no-underline" href={sitePath("/")} aria-label="Mocksmith home">
      <span class="grid size-9 place-items-center rounded-xl bg-gradient-to-br from-indigo-600 to-violet-600 text-sm text-white" aria-hidden="true">M</span>
      <span>Mocksmith</span>
    </a>
    <div class="hidden items-center gap-7 sm:flex">
      {links.map((link) => (
        <a
          class:list={["text-sm font-semibold no-underline hover:text-indigo-700", currentPath.startsWith(link.href) && "text-indigo-700"]}
          href={link.href}
          aria-current={currentPath.startsWith(link.href) ? "page" : undefined}
        >{link.label}</a>
      ))}
    </div>
    <details class="relative sm:hidden">
      <summary class="cursor-pointer rounded-lg px-3 py-2 font-semibold">Menu</summary>
      <div class="absolute right-0 mt-2 grid min-w-48 gap-1 rounded-2xl border border-line bg-white p-2 shadow-xl">
        {links.map((link) => <a class="rounded-lg px-4 py-3 font-medium no-underline hover:bg-indigo-50" href={link.href}>{link.label}</a>)}
      </div>
    </details>
  </nav>
</header>
