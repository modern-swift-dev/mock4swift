---
interface Props {
  code: string;
  language?: string;
  title?: string;
}

const { code, language = "swift", title } = Astro.props;
---

<figure class="my-7 overflow-hidden rounded-2xl border border-slate-700 bg-slate-950 shadow-xl shadow-indigo-950/10">
  {title && <figcaption class="border-b border-slate-700 px-5 py-3 font-mono text-xs text-slate-300">{title}</figcaption>}
  <pre class="overflow-x-auto p-5 text-sm leading-6 text-slate-100" tabindex="0" aria-label={`${language} code`}><code>{code}</code></pre>
</figure>
